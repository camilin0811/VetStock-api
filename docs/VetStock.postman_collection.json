{
  "info": {
    "name": "VetStock API",
    "description": "Coleccion de la API de VetStock. 1) Ejecuta Auth > Login; guarda accessToken automaticamente. 2) Las peticiones de creacion guardan el id en variables para usarlo en las siguientes. Usuarios demo (seed): admin@vetstock.com, vet@vetstock.com, farmacia@vetstock.com con clave VetStock123*.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login (guarda accessToken)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Ejecutar primero. Guarda accessToken y refreshToken en variables de la coleccion.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"admin@vetstock.com\",\n  \"clave\": \"VetStock123*\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login correcto', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json().data;",
                  "pm.collectionVariables.set('accessToken', data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', data.refreshToken);"
                ]
              }
            }
          ]
        },
